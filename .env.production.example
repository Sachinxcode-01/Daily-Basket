# ==================================================
# DAILY BASKET — ENTERPRISE PRODUCTION ENVIRONMENT CONFIG
# ==================================================

# Environment & Server
NODE_ENV=production
PORT=4000
API_BASE_URL=https://api.dailybasket.com/api/v1
CORS_ORIGIN=https://dailybasket.com,https://admin.dailybasket.com,https://delivery.dailybasket.com

# Database (PostgreSQL)
DATABASE_URL="postgresql://db_admin_user:ProdSecurePassword2026!@postgres:5432/daily_basket?schema=public&sslmode=require&pool_timeout=30&connection_limit=50"

# Cache & Queues (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=ProdRedisSecurePassword2026!

# JWT & Authentication Security
JWT_SECRET=daily_basket_prod_jwt_super_secret_key_2026_sign_key_9021
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Google OAuth 2.0
GOOGLE_CLIENT_ID=prod-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-prod-google-oauth-secret

# Razorpay Production Credentials
RAZORPAY_KEY_ID=rzp_live_dailybasket_prod_key_id
RAZORPAY_KEY_SECRET=rzp_live_dailybasket_prod_secret_key
RAZORPAY_WEBHOOK_SECRET=rzp_whsec_dailybasket_prod_secret

# SMTP Email Configuration
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.prod_sendgrid_api_key_daily_basket
EMAIL_FROM="Daily Basket Support <support@dailybasket.com>"

# Object Storage (AWS S3 / GCP Storage)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=daily-basket-prod-media-assets
AWS_ACCESS_KEY_ID=AKIA_PROD_DAILY_BASKET_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=prod_aws_secret_access_key_9021

# Google Maps Platform API
GOOGLE_MAPS_API_KEY=AIzaSy_PROD_GOOGLE_MAPS_API_KEY_DAILY_BASKET

# Gemini AI Engine API Key
GEMINI_API_KEY=AIzaSy_PROD_GEMINI_AI_API_KEY_DAILY_BASKET

# Logging & Monitoring
LOG_LEVEL=info
SENTRY_DSN=https://prod_sentry_dsn_key@o450.ingest.sentry.io/daily-basket-api
