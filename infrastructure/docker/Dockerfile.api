# Production Dockerfile for Daily Basket NestJS API
FROM node:20-alpine AS builder

WORKDIR /app

RUN apk add --no-libc-compat --no-cache python3 make g++

# Copy package files from services/api
COPY services/api/package*.json ./
COPY services/api/prisma ./prisma/

# Install dependencies using standalone package-lock.json
RUN npm ci

# Copy NestJS API source code
COPY services/api/ ./

# Generate Prisma Client & Build NestJS app
RUN npm run prisma:generate
RUN npm run build
RUN npm prune --production

# Production Runner Stage
FROM node:20-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=4000

# Security: Add non-root user
RUN addgroup -g 1001 -S nodejs && adduser -S nestjs -u 1001 -G nodejs

# Copy built application and node_modules from builder
COPY --chown=nestjs:nodejs --from=builder /app/package*.json ./
COPY --chown=nestjs:nodejs --from=builder /app/node_modules ./node_modules
COPY --chown=nestjs:nodejs --from=builder /app/dist ./dist
COPY --chown=nestjs:nodejs --from=builder /app/prisma ./prisma

USER nestjs

EXPOSE 4000

CMD ["node", "dist/main"]

