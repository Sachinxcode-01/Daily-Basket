# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

RUN apk add --no-cache openssl libc6-compat

RUN corepack enable && corepack prepare pnpm@9 --activate

# Copy workspace metadata first
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Copy package manifests needed for dependency resolution
COPY services/api/package.json ./services/api/package.json
COPY packages/ ./packages/
COPY apps/admin/package.json ./apps/admin/package.json
COPY apps/delivery/package.json ./apps/delivery/package.json
COPY apps/website/package.json ./apps/website/package.json

RUN pnpm install --frozen-lockfile

# Copy only application source and Prisma files.
# Do not copy node_modules from the host.
COPY services/api/nest-cli.json services/api/tsconfig*.json ./services/api/
COPY services/api/prisma ./services/api/prisma
COPY services/api/src ./services/api/src
COPY services/api/test ./services/api/test

WORKDIR /app/services/api

RUN pnpm exec prisma generate
RUN pnpm run build

# Production stage
FROM node:20-alpine AS runner

WORKDIR /app

RUN apk add --no-cache openssl libc6-compat \
    && addgroup -g 1001 -S nodejs \
    && adduser -S nestjs -u 1001

ENV NODE_ENV=production

COPY --from=builder /app/services/api/dist ./dist
COPY --from=builder /app/services/api/node_modules ./node_modules
COPY --from=builder /app/services/api/package.json ./package.json
COPY --from=builder /app/services/api/prisma ./prisma

USER nestjs

EXPOSE 4000

CMD ["node", "dist/main"]
