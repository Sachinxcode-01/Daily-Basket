generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  STORE_MANAGER
  INVENTORY_MANAGER
  SUPPORT_EXECUTIVE
  FINANCE_MANAGER
  DELIVERY_PARTNER
  BUSINESS_OWNER
  SUPER_ADMIN
}


enum OrderStatus {
  CREATED
  CONFIRMED
  PACKING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  NET_BANKING
  WALLET
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Store {
  id           String      @id @default(uuid())
  name         String
  code         String      @unique
  address      String
  city         String
  pincode      String
  latitude     Float
  longitude    Float
  isOpen       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  products     Product[]
  orders       Order[]
  inventories  Inventory[]

  @@map("stores")
}

model User {
  id                      String                  @id @default(uuid())
  phoneNumber             String                  @unique
  email                   String?                 @unique
  fullName                String
  passwordHash            String?
  role                    Role                    @default(CUSTOMER)
  avatarUrl               String?
  isVerified              Boolean                 @default(false)
  emailVerificationToken  String?                 @unique
  emailVerificationExpires DateTime?
  passwordResetToken      String?                 @unique
  passwordResetExpires    DateTime?
  mfaEnabled              Boolean                 @default(false)
  mfaType                 String?                 // TOTP, EMAIL, SMS
  mfaSecret               String?
  mfaBackupCodes          String[]                @default([])
  failedLoginAttempts     Int                     @default(0)
  lockoutUntil            DateTime?
  lastLoginAt             DateTime?
  lastPasswordChange      DateTime?
  termsAccepted           Boolean                 @default(true)
  privacyAccepted         Boolean                 @default(true)
  marketingConsent        Boolean                 @default(false)
  referralCode            String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  addresses               Address[]
  orders                  Order[]                 @relation("CustomerOrders")
  deliveries              Order[]                 @relation("DeliveryPartnerOrders")
  wallet                  Wallet?
  reviews                 Review[]
  impact                  UserImpact?
  badges                  UserBadge[]
  tickets                 SupportTicket[]
  stockAlerts             StockAlert[]
  aiSessions              AiConversationSession[]
  wishlist                Wishlist[]
  recentlyViewed          RecentlyViewed[]
  deviceSessions          DeviceSession[]
  otpVerifications        OtpVerification[]
  securityAuditLogs       SecurityAuditLog[]
  passwordHistories       PasswordHistory[]

  @@map("users")
}

model Address {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String   // HOME, WORK, OTHER
  houseNo     String
  street      String
  landmark    String?
  city        String
  pincode     String
  latitude    Float
  longitude   Float
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]

  @@map("addresses")
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  imageUrl    String?
  iconName    String?
  parentId    String?
  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[] @relation("SubCategories")
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  products    Product[]

  @@map("categories")
}

model Product {
  id          String           @id @default(uuid())
  storeId     String
  store       Store            @relation(fields: [storeId], references: [id])
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id])
  name        String
  slug        String           @unique
  description String
  images      String[]
  isOrganic   Boolean          @default(false)
  tags        String[]
  variants    ProductVariant[]
  reviews     Review[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("products")
}

model ProductVariant {
  id            String      @id @default(uuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitName      String      // e.g. 500g, 1 kg
  price         Float
  mrp           Float
  sku           String      @unique
  isAvailable   Boolean     @default(true)
  inventories   Inventory[]
  orderItems    OrderItem[]
  stockAlerts   StockAlert[]

  @@map("product_variants")
}

model Inventory {
  id               String         @id @default(uuid())
  storeId          String
  store            Store          @relation(fields: [storeId], references: [id])
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id])
  stockQuantity    Int            @default(0)
  reservedQuantity Int            @default(0)
  updatedAt        DateTime       @updatedAt

  @@unique([storeId, variantId])
  @@map("inventories")
}

model Order {
  id                   String        @id @default(uuid())
  orderNumber          String        @unique
  storeId              String
  store                Store         @relation(fields: [storeId], references: [id])
  userId               String
  user                 User          @relation("CustomerOrders", fields: [userId], references: [id])
  addressId            String
  address              Address       @relation(fields: [addressId], references: [id])
  deliveryPartnerId    String?
  deliveryPartner      User?         @relation("DeliveryPartnerOrders", fields: [deliveryPartnerId], references: [id])
  items                OrderItem[]
  subtotal             Float
  deliveryFee          Float
  discount             Float
  totalAmount          Float
  status               OrderStatus   @default(CREATED)
  paymentMethod        PaymentMethod
  paymentStatus        PaymentStatus @default(PENDING)
  estimatedArrivalMins Int           @default(10)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  payments             Payment[]

  @@map("orders")
}

model OrderItem {
  id          String         @id @default(uuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  productName String
  unitName    String
  price       Float
  quantity    Int
  totalPrice  Float

  @@map("order_items")
}

model Payment {
  id              String        @id @default(uuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id])
  razorpayOrderId String?
  transactionRef  String?
  amount          Float
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now())

  @@map("payments")
}

model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique
  discountType   String    // PERCENTAGE, FLAT
  discountValue  Float
  minOrderAmount Float     @default(0)
  maxDiscount    Float?
  expiresAt      DateTime
  isActive       Boolean   @default(true)

  @@map("coupons")
}

model Wallet {
  id           String              @id @default(uuid())
  userId       String              @unique
  user         User                @relation(fields: [userId], references: [id])
  balance      Float               @default(0)
  transactions WalletTransaction[]
  updatedAt    DateTime            @updatedAt

  @@map("wallets")
}

model WalletTransaction {
  id          String   @id @default(uuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id])
  amount      Float
  type        String   // CREDIT, DEBIT
  description String
  createdAt   DateTime @default(now())

  @@map("wallet_transactions")
}

model Review {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@map("reviews")
}

model UserImpact {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impactPoints     Int      @default(0)
  plasticSavedKg   Float    @default(0)
  co2ReducedKg     Float    @default(0)
  paperBagsSaved   Int      @default(0)
  ecoDeliveries    Int      @default(0)
  greenOrders      Int      @default(0)
  monthlyProgress  Float    @default(0)
  yearlyProgress   Float    @default(0)
  treesEquivalent  Float    @default(0)
  level            String   @default("Earth Champion")
  updatedAt        DateTime @updatedAt

  @@map("user_impacts")
}

model UserBadge {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  tier        String
  iconName    String
  earnedAt    DateTime @default(now())

  @@map("user_badges")
}

model SupportTicket {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  status    String        @default("OPEN") // OPEN, IN_PROGRESS, CLOSED
  rating    Int?
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("support_tickets")
}

model ChatMessage {
  id            String        @id @default(uuid())
  ticketId      String
  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId      String
  senderName    String
  text          String
  isAgent       Boolean       @default(false)
  attachmentUrl String?
  createdAt     DateTime      @default(now())

  @@map("chat_messages")
}

model StockAlert {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  isEnabled  Boolean        @default(true)
  status     String         @default("OUT_OF_STOCK") // OUT_OF_STOCK, RESTOCKED
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([userId, variantId])
  @@map("stock_alerts")
}

model AiConversationSession {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentRoute   String?
  contextData    Json?           // Dynamic app state context (order, cart, product)
  status         String          @default("ACTIVE") // ACTIVE, ESCALATED, CLOSED
  activeProvider String          @default("GEMINI")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  messages       AiChatMessage[]
  auditLogs      AiAuditLog[]

  @@map("ai_conversation_sessions")
}

model AiChatMessage {
  id           String                @id @default(uuid())
  sessionId    String
  session      AiConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  senderRole   String                // USER, ASSISTANT, SYSTEM, TOOL
  content      String
  toolCalls    Json?                 // Tool call details if any
  cardType     String?               // order_status, refund_card, item_complaint, etc.
  cardData     Json?                 // Structured data for UI card
  tokensUsed   Int?
  latencyMs    Int?
  providerUsed String?
  createdAt    DateTime              @default(now())

  @@map("ai_chat_messages")
}

model AiAuditLog {
  id         String                 @id @default(uuid())
  userId     String
  sessionId  String?
  session    AiConversationSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  action     String
  toolName   String
  parameters Json?
  ipAddress  String?
  status     String                 @default("SUCCESS") // SUCCESS, DENIED, FAILED
  createdAt  DateTime               @default(now())

  @@map("ai_audit_logs")
}

model AiAnalyticsMetric {
  id               String   @id @default(uuid())
  provider         String
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  costUsd          Float    @default(0.0)
  latencyMs        Int      @default(0)
  success          Boolean  @default(true)
  feedbackRating   Int?     // 1-5 rating if provided by user
  createdAt        DateTime @default(now())

  @@map("ai_analytics_metrics")
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("wishlists")
}

model RecentlyViewed {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  viewedAt  DateTime @default(now())

  @@unique([userId, productId])
  @@map("recently_viewed")
}

model DeviceSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId     String
  deviceName   String?
  platform     String?
  osVersion    String?
  ipAddress    String?
  location     String?
  refreshToken String   @unique
  isActive     Boolean  @default(true)
  lastActive   DateTime @default(now())
  expiresAt    DateTime @default(now())
  createdAt    DateTime @default(now())

  @@map("device_sessions")
}

model OtpVerification {
  id           String    @id @default(uuid())
  identifier   String    // phone or email
  otpHash      String
  type         String    // LOGIN, REGISTRATION, PASSWORD_RESET, MFA
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3)
  expiresAt    DateTime
  resendAfter  DateTime
  consumedAt   DateTime?
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())

  @@index([identifier, type])
  @@map("otp_verifications")
}

model SecurityAuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  event     String   // LOGIN_SUCCESS, LOGIN_FAILED, PASSWORD_CHANGE, EMAIL_CHANGE, PHONE_CHANGE, LOGOUT, LOGOUT_ALL, MFA_ENABLED, MFA_DISABLED, LOCKOUT, SESSION_REVOKED
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@map("security_audit_logs")
}

model PasswordHistory {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("password_histories")
}

model OrderInvoice {
  id            String   @id @default(uuid())
  orderId       String   @unique
  invoiceNumber String   @unique
  pdfUrl        String
  taxAmount     Float    @default(0.0)
  totalAmount   Float
  issuedAt      DateTime @default(now())

  @@map("order_invoices")
}



