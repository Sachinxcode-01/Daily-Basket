generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  STORE_MANAGER
  INVENTORY_MANAGER
  SUPPORT_EXECUTIVE
  FINANCE_MANAGER
  DELIVERY_PARTNER
  BUSINESS_OWNER
  SUPER_ADMIN
}


enum OrderStatus {
  CREATED
  CONFIRMED
  PACKING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  NET_BANKING
  WALLET
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Store {
  id           String      @id @default(uuid())
  name         String
  code         String      @unique
  address      String
  city         String
  pincode      String
  latitude     Float
  longitude    Float
  isOpen       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  products     Product[]
  orders       Order[]
  inventories  Inventory[]
  settings     StoreSettings?

  @@map("stores")
}

model User {
  id                      String                  @id @default(uuid())
  phoneNumber             String                  @unique
  email                   String?                 @unique
  fullName                String
  passwordHash            String?
  role                    Role                    @default(CUSTOMER)
  avatarUrl               String?
  isVerified              Boolean                 @default(false)
  emailVerificationToken  String?                 @unique
  emailVerificationExpires DateTime?
  passwordResetToken      String?                 @unique
  passwordResetExpires    DateTime?
  mfaEnabled              Boolean                 @default(false)
  mfaType                 String?                 // TOTP, EMAIL, SMS
  mfaSecret               String?
  mfaBackupCodes          String[]                @default([])
  failedLoginAttempts     Int                     @default(0)
  lockoutUntil            DateTime?
  lastLoginAt             DateTime?
  lastPasswordChange      DateTime?
  termsAccepted           Boolean                 @default(true)
  privacyAccepted         Boolean                 @default(true)
  marketingConsent        Boolean                 @default(false)
  referralCode            String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  addresses               Address[]
  orders                  Order[]                 @relation("CustomerOrders")
  deliveries              Order[]                 @relation("DeliveryPartnerOrders")
  wallet                  Wallet?
  reviews                 Review[]
  impact                  UserImpact?
  badges                  UserBadge[]
  tickets                 SupportTicket[]
  stockAlerts             StockAlert[]
  aiSessions              AiConversationSession[]
  wishlist                Wishlist[]
  favorites               Favorite[]
  recentlyViewed          RecentlyViewed[]
  deviceSessions          DeviceSession[]
  otpVerifications        OtpVerification[]
  securityAuditLogs       SecurityAuditLog[]
  passwordHistories       PasswordHistory[]
  preferenceProfile       UserPreferenceProfile?
  voiceSessions           VoiceSession[]
  voiceLogs               VoiceCommandLog[]
  voiceSettings           VoiceSettings?
  imageSearchLogs         ImageSearchLog[]
  groceryLists            GroceryList[]
  predictiveItems         PredictiveReorderItem[]
  personalizedOffers      PersonalizedOffer[]
  cart                    Cart?
  couponRedemptions       CouponRedemption[]

  @@map("users")
}

model Address {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String   // HOME, WORK, OTHER
  houseNo     String
  street      String
  landmark    String?
  city        String
  pincode     String
  latitude    Float
  longitude   Float
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]

  @@map("addresses")
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?
  bannerImage String?
  iconName    String?
  parentId    String?
  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[] @relation("SubCategories")
  sortOrder   Int        @default(0)
  isFeatured  Boolean    @default(false)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  products    Product[]

  @@map("categories")
}

model Product {
  id          String           @id @default(uuid())
  storeId     String
  store       Store            @relation(fields: [storeId], references: [id])
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id])
  name        String
  slug        String           @unique
  description String
  images          String[]
  packageImages   String[]         @default([])
  barcode         String?          @unique
  brand           String?
  brandAliases    String[]         @default([])
  searchKeywords  String[]         @default([])
  isOrganic       Boolean          @default(false)
  tags            String[]
  variants        ProductVariant[]
  reviews         Review[]
  favorites       Favorite[]
  aiInsight       ProductAiInsight?
  referenceImages ProductReferenceImage[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([storeId, categoryId])
  @@index([brand])
  @@index([createdAt])
  @@map("products")
}

model ProductVariant {
  id            String      @id @default(uuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitName      String      // e.g. 500g, 1 kg
  price         Float
  mrp           Float
  sku           String      @unique
  isAvailable   Boolean     @default(true)
  inventories   Inventory[]
  orderItems    OrderItem[]
  stockAlerts   StockAlert[]

  @@index([productId, isAvailable])
  @@index([price])
  @@map("product_variants")
}

model Inventory {
  id               String         @id @default(uuid())
  storeId          String
  store            Store          @relation(fields: [storeId], references: [id])
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id])
  stockQuantity    Int            @default(0)
  reservedQuantity Int            @default(0)
  updatedAt        DateTime       @updatedAt

  @@unique([storeId, variantId])
  @@index([storeId])
  @@index([variantId])
  @@index([stockQuantity])
  @@map("inventories")
}

model Order {
  id                   String        @id @default(uuid())
  orderNumber          String        @unique
  storeId              String
  store                Store         @relation(fields: [storeId], references: [id])
  userId               String
  user                 User          @relation("CustomerOrders", fields: [userId], references: [id])
  addressId            String
  address              Address       @relation(fields: [addressId], references: [id])
  deliveryPartnerId    String?
  deliveryPartner      User?         @relation("DeliveryPartnerOrders", fields: [deliveryPartnerId], references: [id])
  items                OrderItem[]
  subtotal             Float
  deliveryFee          Float
  discount             Float
  totalAmount          Float
  status               OrderStatus   @default(CREATED)
  paymentMethod        PaymentMethod
  paymentStatus        PaymentStatus @default(PENDING)
  estimatedArrivalMins Int           @default(10)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  payments             Payment[]

  @@index([userId, status])
  @@index([storeId, status])
  @@index([createdAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id          String         @id @default(uuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  productName String
  unitName    String
  price       Float
  quantity    Int
  totalPrice  Float

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model Payment {
  id              String        @id @default(uuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id])
  razorpayOrderId String?
  transactionRef  String?
  amount          Float
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now())

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

model Coupon {
  id                String             @id @default(uuid())
  code              String             @unique
  title             String             @default("Promotional Offer")
  description       String             @default("Special discount coupon")
  discountType      String             // PERCENTAGE, FLAT, FREE_DELIVERY, CASHBACK
  discountValue     Float
  minOrderAmount    Float              @default(0)
  maxDiscount       Float?
  category          String?
  startDate         DateTime           @default(now())
  expiresAt         DateTime
  isActive          Boolean            @default(true)
  usageLimitPerUser Int                @default(1)
  totalUsageLimit   Int                @default(10000)
  usedCount         Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt
  redemptions       CouponRedemption[]

  @@index([code])
  @@index([isActive])
  @@map("coupons")
}

model Wallet {
  id           String              @id @default(uuid())
  userId       String              @unique
  user         User                @relation(fields: [userId], references: [id])
  balance      Float               @default(0)
  transactions WalletTransaction[]
  updatedAt    DateTime            @updatedAt

  @@map("wallets")
}

model WalletTransaction {
  id          String   @id @default(uuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id])
  amount      Float
  type        String   // CREDIT, DEBIT
  description String
  createdAt   DateTime @default(now())

  @@map("wallet_transactions")
}

model Review {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@index([productId, rating])
  @@index([userId])
  @@map("reviews")
}

model UserImpact {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impactPoints     Int      @default(0)
  plasticSavedKg   Float    @default(0)
  co2ReducedKg     Float    @default(0)
  paperBagsSaved   Int      @default(0)
  ecoDeliveries    Int      @default(0)
  greenOrders      Int      @default(0)
  monthlyProgress  Float    @default(0)
  yearlyProgress   Float    @default(0)
  treesEquivalent  Float    @default(0)
  level            String   @default("Earth Champion")
  updatedAt        DateTime @updatedAt

  @@map("user_impacts")
}

model UserBadge {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  tier        String
  iconName    String
  earnedAt    DateTime @default(now())

  @@map("user_badges")
}

model SupportTicket {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  status    String        @default("OPEN") // OPEN, IN_PROGRESS, CLOSED
  rating    Int?
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId, status])
  @@index([createdAt])
  @@map("support_tickets")
}

model ChatMessage {
  id            String        @id @default(uuid())
  ticketId      String
  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId      String
  senderName    String
  text          String
  isAgent       Boolean       @default(false)
  attachmentUrl String?
  createdAt     DateTime      @default(now())

  @@map("chat_messages")
}

model StockAlert {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  isEnabled  Boolean        @default(true)
  status     String         @default("OUT_OF_STOCK") // OUT_OF_STOCK, RESTOCKED
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([userId, variantId])
  @@map("stock_alerts")
}

model AiConversationSession {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentRoute   String?
  contextData    Json?           // Dynamic app state context (order, cart, product)
  status         String          @default("ACTIVE") // ACTIVE, ESCALATED, CLOSED
  activeProvider String          @default("GEMINI")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  messages       AiChatMessage[]
  auditLogs      AiAuditLog[]

  @@map("ai_conversation_sessions")
}

model AiChatMessage {
  id           String                @id @default(uuid())
  sessionId    String
  session      AiConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  senderRole   String                // USER, ASSISTANT, SYSTEM, TOOL
  content      String
  toolCalls    Json?                 // Tool call details if any
  cardType     String?               // order_status, refund_card, item_complaint, etc.
  cardData     Json?                 // Structured data for UI card
  tokensUsed   Int?
  latencyMs    Int?
  providerUsed String?
  createdAt    DateTime              @default(now())

  @@map("ai_chat_messages")
}

model AiAuditLog {
  id         String                 @id @default(uuid())
  userId     String
  sessionId  String?
  session    AiConversationSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  action     String
  toolName   String
  parameters Json?
  ipAddress  String?
  status     String                 @default("SUCCESS") // SUCCESS, DENIED, FAILED
  createdAt  DateTime               @default(now())

  @@map("ai_audit_logs")
}

model AiAnalyticsMetric {
  id               String   @id @default(uuid())
  provider         String
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  costUsd          Float    @default(0.0)
  latencyMs        Int      @default(0)
  success          Boolean  @default(true)
  feedbackRating   Int?     // 1-5 rating if provided by user
  createdAt        DateTime @default(now())

  @@map("ai_analytics_metrics")
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("wishlists")
}

model RecentlyViewed {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  viewedAt  DateTime @default(now())

  @@unique([userId, productId])
  @@map("recently_viewed")
}

model DeviceSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId     String
  deviceName   String?
  platform     String?
  osVersion    String?
  ipAddress    String?
  location     String?
  refreshToken String   @unique
  isActive     Boolean  @default(true)
  lastActive   DateTime @default(now())
  expiresAt    DateTime @default(now())
  createdAt    DateTime @default(now())

  @@map("device_sessions")
}

model OtpVerification {
  id           String    @id @default(uuid())
  identifier   String    // phone or email
  otpHash      String
  type         String    // LOGIN, REGISTRATION, PASSWORD_RESET, MFA
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3)
  expiresAt    DateTime
  resendAfter  DateTime
  consumedAt   DateTime?
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())

  @@index([identifier, type])
  @@map("otp_verifications")
}

model SecurityAuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  event     String   // LOGIN_SUCCESS, LOGIN_FAILED, PASSWORD_CHANGE, EMAIL_CHANGE, PHONE_CHANGE, LOGOUT, LOGOUT_ALL, MFA_ENABLED, MFA_DISABLED, LOCKOUT, SESSION_REVOKED
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, event])
  @@index([createdAt])
  @@map("security_audit_logs")
}

model PasswordHistory {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("password_histories")
}

model OrderInvoice {
  id            String   @id @default(uuid())
  orderId       String   @unique
  invoiceNumber String   @unique
  pdfUrl        String
  taxAmount     Float    @default(0.0)
  totalAmount   Float
  issuedAt      DateTime @default(now())

  @@map("order_invoices")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("favorites")
}

model PromptTemplate {
  id          String   @id @default(uuid())
  key         String   @unique // SEARCH_INTENT, SHOPPING_ASSISTANT, RECOMMENDATIONS, IMAGE_ANALYSIS, RECIPE_GENERATION, PRODUCT_COMPARISON
  name        String
  template    String
  description String?
  version     Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("prompt_templates")
}

model SearchAnalytics {
  id               String   @id @default(uuid())
  query            String
  intent           String?
  resultsCount     Int      @default(0)
  userId           String?
  clickedProductId String?
  latencyMs        Int      @default(0)
  isSuccess        Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@index([query])
  @@index([createdAt])
  @@map("search_analytics")
}

model TrendingSearch {
  id          String   @id @default(uuid())
  keyword     String   @unique
  category    String?
  searchCount Int      @default(1)
  isFeatured  Boolean  @default(false)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  @@map("trending_searches")
}

model BlockedQuery {
  id        String   @id @default(uuid())
  pattern   String   @unique
  reason    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("blocked_queries")
}

model ProductAiInsight {
  id                 String   @id @default(uuid())
  productId          String   @unique
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  benefits           String[] @default([])
  usage              String?
  storage            String?
  healthyChoice      Boolean  @default(false)
  healthScore        Float    @default(8.5)
  bestFor            String[] @default([])
  recipeSuggestions  Json?
  servingSuggestions String?
  suitableAge        String?  // e.g. "6+ months", "All ages", "Kids 2-12"
  nutritionalSummary Json?
  comparisonPoints   Json?
  updatedAt          DateTime @updatedAt

  @@map("product_ai_insights")
}

model UserPreferenceProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  favoriteCategories String[] @default([])
  favoriteBrands     String[] @default([])
  dietaryPreferences String[] @default([]) // Organic, High-Protein, Sugar-Free, Vegan, Gluten-Free
  budgetTier         String   @default("BALANCED") // BUDGET, BALANCED, PREMIUM
  shoppingFrequency  String   @default("WEEKLY") // DAILY, WEEKLY, BIWEEKLY
  updatedAt          DateTime @updatedAt

  @@map("user_preference_profiles")
}

model VoiceSession {
  id           String            @id @default(uuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  locale       String            @default("en_IN") // en_IN, hi_IN, kn_IN, ta_IN, te_IN, ml_IN, mr_IN
  currentRoute String            @default("/home")
  status       String            @default("ACTIVE") // ACTIVE, COMPLETED, EXPIRED
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  logs         VoiceCommandLog[]

  @@map("voice_sessions")
}

model VoiceCommandLog {
  id               String        @id @default(uuid())
  sessionId        String
  session          VoiceSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcription    String
  detectedLanguage String        @default("en_IN")
  intent           String?       // SEARCH, ADD_TO_CART, NAVIGATE, TRACK_ORDER, SUPPORT, RECIPE
  actionTaken      String?
  audioUrl         String?
  latencyMs        Int           @default(0)
  isSuccess        Boolean       @default(true)
  createdAt        DateTime      @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("voice_command_logs")
}

model VoiceSettings {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  voiceEnabled         Boolean  @default(true)
  preferredLanguage    String   @default("en_IN")
  preferredVoiceGender String   @default("FEMALE") // FEMALE, MALE
  speechSpeed          Float    @default(1.0) // 0.75 to 1.5
  autoSpeak            Boolean  @default(true)
  privacyMode          Boolean  @default(false)
  updatedAt            DateTime @updatedAt

  @@map("voice_settings")
}

model VoiceAnalyticsMetric {
  id               String   @id @default(uuid())
  language         String   @default("en_IN")
  intent           String?
  sttLatencyMs     Int      @default(0)
  aiLatencyMs      Int      @default(0)
  ttsLatencyMs     Int      @default(0)
  isSuccess        Boolean  @default(true)
  failureReason    String?
  rating           Int?     // 1-5
  createdAt        DateTime @default(now())

  @@index([language])
  @@index([createdAt])
  @@map("voice_analytics_metrics")
}

model ImageSearchLog {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageUrl          String
  imageHash         String?
  detectedProducts  Json?    // Array of detected product objects with bounding boxes
  ocrText           String?  // Extracted raw OCR text from packaging
  recipeName        String?  // Identified dish/recipe name if food item
  confidenceScore   Float    @default(95.0)
  latencyMs         Int      @default(0)
  isSuccess         Boolean  @default(true)
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("image_search_logs")
}

model ProductReferenceImage {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl    String
  angle       String   @default("FRONT") // FRONT, BACK, LABEL, NUTRITION, INGREDIENTS
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([productId])
  @@map("product_reference_images")
}

model VisualAiAnalyticsMetric {
  id                   String   @id @default(uuid())
  totalSearches        Int      @default(0)
  successfulMatches    Int      @default(0)
  failedMatches        Int      @default(0)
  avgLatencyMs         Int      @default(0)
  ocrSuccessRate       Float    @default(98.5)
  recipeDetectionRate  Float    @default(94.2)
  createdAt            DateTime @default(now())

  @@index([createdAt])
  @@map("visual_ai_analytics_metrics")
}

model GroceryList {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String   // e.g. "Weekly Essentials", "Monthly Grocery", "Family BBQ"
  type               String   @default("CUSTOM") // WEEKLY, MONTHLY, CUSTOM, AI_GENERATED
  items              Json     // Array of list item objects
  isRecurring        Boolean  @default(false)
  reminderFrequency  String?  // WEEKLY, BIWEEKLY, MONTHLY
  createdAt          DateTime @default(now())
